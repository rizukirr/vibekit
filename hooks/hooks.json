{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start using-vibekit",
            "commandWindows": "& \"$env:PLUGIN_ROOT/hooks/run-hook.cmd\" session-start using-vibekit",
            "shell": "bash",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start lazy",
            "commandWindows": "& \"$env:PLUGIN_ROOT/hooks/run-hook.cmd\" session-start lazy",
            "shell": "bash",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start plain",
            "commandWindows": "& \"$env:PLUGIN_ROOT/hooks/run-hook.cmd\" session-start plain",
            "shell": "bash",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start terse",
            "commandWindows": "& \"$env:PLUGIN_ROOT/hooks/run-hook.cmd\" session-start terse",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
