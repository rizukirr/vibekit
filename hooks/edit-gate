#!/usr/bin/env bash
# PreToolUse hook: denies Write, Edit and NotebookEdit in the main session
# until a working vibekit skill has run, then until every modifier has run.
# $1 is the working skill list and $2 the modifier list, each joined with +.

set -uo pipefail

if [ "${VIBEKIT_GATE:-}" = "off" ]; then
    exit 0
fi

input=$(cat)

# A subagent's call carries agent_id, and vibekit's subagents are dispatched
# by a stage that already passed the gate. Inside a JSON string the quotes
# are escaped, so an unescaped "agent_id" can only be the key itself.
case "$input" in
    *'"agent_id"'*) exit 0 ;;
esac

path=$(printf '%s' "$input" \
    | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | head -n 1 \
    | sed 's/\\\\/\\/g')

# Fail open: a missing or unreadable record must never block every edit.
if [ -z "$path" ] || [ ! -r "$path" ]; then
    exit 0
fi

names=$(printf '%s' "${1:-}" | tr '+' '|')
if [ -z "$names" ]; then
    exit 0
fi

# Only the two exact record forms count. The bare text /vibekit:<name>
# also appears in skill descriptions, which every session carries.
missing=""
if ! grep -qE "\"name\":\"Skill\",\"input\":\\{\"skill\":\"vibekit:($names)\"|<command-name>/vibekit:($names)</command-name>" "$path"; then
    missing=" vibekit:quick"
fi

# A modifier is never typed as a command, so only the Skill call counts.
for name in $(printf '%s' "${2:-}" | tr '+' ' '); do
    if ! grep -qF "\"name\":\"Skill\",\"input\":{\"skill\":\"vibekit:$name\"" "$path"; then
        missing="$missing vibekit:$name"
    fi
done
if [ -z "$missing" ]; then
    exit 0
fi

# A deny decision reaches the model as a rule with a reason. A plain exit 2
# is shown as a hook error, which models retry as if the hook were broken.
# The reason holds no double quote or backslash, so it is valid JSON as is.
reason="vibekit denied this edit, so the file was not changed. Call the Skill tool for each of these, in order:$missing. Then retry the edit. Retrying first is denied again. To turn this check off, set VIBEKIT_GATE=off."
printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$reason"
exit 0
